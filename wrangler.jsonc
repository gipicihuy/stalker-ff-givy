{
	"$schema": "node_modules/wrangler/config-schema.json",
	// Entry point custom (bukan langsung .open-next/worker.js) supaya kita
	// bisa nge-export Durable Object class EdgeGuardDO dari worker yang sama.
	// Lihat src/worker.ts - dia cuma re-export fetch handler hasil build
	// OpenNext apa adanya, jadi behavior Next.js-nya sama sekali nggak berubah.
	"main": "src/worker.ts",
	"name": "ff-stalker-givy",
	"compatibility_date": "2026-08-01",
	"compatibility_flags": [
		// Enable Node.js API
		// see https://developers.cloudflare.com/workers/configuration/compatibility-flags/#nodejs-compatibility-flag
		"nodejs_compat",
		// Allow to fetch URLs in your app
		// see https://developers.cloudflare.com/workers/configuration/compatibility-flags/#global-fetch-strictly-public
		"global_fetch_strictly_public"
	],
	"assets": {
		"directory": ".open-next/assets",
		"binding": "ASSETS"
	},
	"services": [
		{
			// Self-reference service binding, the service name must match the worker name
			// see https://opennext.js.org/cloudflare/caching
			"binding": "WORKER_SELF_REFERENCE",
			"service": "ff-stalker-givy"
		}
	],
	// Durable Object dipakai buat anti-scraping: rate limit per-IP, replay
	// guard buat handshake token, dan blacklist IP honeypot. Semua state-nya
	// per-IP (DO id di-derive dari IP), jadi konsisten di seluruh edge -
	// beda dari in-memory Map yang cuma hidup per-isolate/per-region.
	"durable_objects": {
		"bindings": [
			{
				"name": "EDGE_GUARD",
				"class_name": "EdgeGuardDO"
			}
		]
	},
	"migrations": [
		{
			"tag": "v1",
			"new_sqlite_classes": ["EdgeGuardDO"]
		}
	],
	// Secret buat HMAC handshake token & signed image URL. JANGAN taruh
	// value asli di sini - set lewat:
	//   npx wrangler secret put FP_SIGNING_SECRET
	// Baris "vars" di bawah cuma placeholder dev/local (dipakai kalau secret
	// belum di-set), supaya `wrangler dev` tetap jalan.
	//
	// FF_OB_VERSION: override versi game (ReleaseVersion header) yang dikirim
	// ffapis pas login guest ke Garena. Free Fire pindah dari OB54 -> OB55
	// tanggal 16 September 2026, tapi ffapis (vendor lokal 1.6.0 maupun
	// rilis npm terbaru 3.0.1) masih hardcode default "OB54", bikin semua
	// login guest ditolak Garena (MajorLogin gagal terus) -> circuit breaker
	// pencarian nickname langsung "down". Env var ini dibaca ffapis sendiri
	// (lib/constants.ts: resolveObVersion, prioritas request > instance >
	// env > settings.yaml default), jadi cukup di-set di sini tanpa perlu
	// ubah kode di vendor/ffapis atau tiap pemanggilan `new FreeFireAPI()`.
	"vars": {
		"FP_SIGNING_SECRET": "dev-insecure-fallback-secret-change-me",
		"FF_OB_VERSION": "OB55"
	}
}
